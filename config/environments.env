# ==============================================================================
# Environment Configuration Variables for Deployment & Automation
# ==============================================================================
OCP_CLUSTER_DEV_NAME="ocp-dev"
OCP_CLUSTER_STAGING_NAME="ocp-staging"
OCP_CLUSTER_PROD_NAME="ocp-prod"

OCP_APPS_DOMAIN="apps.ocp-dev.nubenetes.internal"
OCP_JENKINS_NAMESPACE="jenkins"
OCP_ARGOCD_NAMESPACE="argocd"
OCP_OBSERVABILITY_NAMESPACE="observability"

# Pinned Versions
JENKINS_HELM_VERSION="5.8.31"
JENKINS_IMAGE_TAG="2.492.2-lts-jdk21"
ARGOCD_HELM_VERSION="7.8.2"
ARGOCD_APP_VERSION="v3.5.0"
OTEL_COLLECTOR_HELM_VERSION="0.117.0"
GRAFANA_HELM_VERSION="8.10.1"
PROMETHEUS_HELM_VERSION="27.4.0"

# Repositories
GIT_ORG="nubenetes"
GLOBAL_VARS_REPO_URL="https://github.com/nubenetes/jenkins-git-parameter-global-vars.git"
GLOBAL_VARS_DEFAULT_BRANCH="main"
APP_SAMPLE_REPO_URL="https://github.com/nubenetes/jhipster-microservice.git"
JENKINS_SHARED_LIB_REPO_URL="https://github.com/nubenetes/jenkins-git-parameter.git"
