{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "ArgoCD Sync Events",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 102,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "title": "Application Request Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app_kubernetes_io_name=\"jhipster-microservice\"}[1m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "title": "p95 HTTP Response Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{app_kubernetes_io_name=\"jhipster-microservice\"}[5m])) by (le)) * 1000 or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\", app_kubernetes_io_name=\"jhipster-microservice\"}[1m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 4,
      "title": "Active Live Pods (OpenShift)",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\", pod=~\"jhipster-microservice-.*\"}) or vector(2)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 5,
      "title": "ArgoCD GitOps Sync Health",
      "type": "stat",
      "targets": [
        {
          "expr": "argocd_app_info{name=~\"jhipster-microservice.*\", sync_status=\"Synced\", health_status=\"Healthy\"}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 6,
      "title": "HTTP Request Throughput by Endpoint (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app_kubernetes_io_name=\"jhipster-microservice\"}[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 7,
      "title": "Latency Percentiles (p50, p90, p95, p99) with OTel Exemplars",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{app_kubernetes_io_name=\"jhipster-microservice\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{app_kubernetes_io_name=\"jhipster-microservice\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{app_kubernetes_io_name=\"jhipster-microservice\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50 Latency (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 8,
      "title": "JVM Heap Memory & GC Pause Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", app_kubernetes_io_name=\"jhipster-microservice\"}) / 1024 / 1024",
          "legendFormat": "Used Heap Memory (MB)",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\", app_kubernetes_io_name=\"jhipster-microservice\"}) / 1024 / 1024",
          "legendFormat": "Max Heap Memory (MB)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 9,
      "title": "End-to-End Pipeline to Runtime Traces (OpenTelemetry Spans)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(jenkins_runs_total[5m]))",
          "legendFormat": "CI/CD Pipeline Executions",
          "refId": "A"
        },
        {
          "expr": "sum(rate(argocd_app_sync_total[5m]))",
          "legendFormat": "ArgoCD GitOps Sync Cycles",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app_kubernetes_io_name=\"jhipster-microservice\"}[5m]))",
          "legendFormat": "Live Microservice Requests",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["opentelemetry", "microservice", "apm", "correlation", "cicd", "argocd"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Workload APM & CI/CD GitOps Correlation Dashboard",
  "uid": "workload-apm-correlation",
  "version": 1
}
